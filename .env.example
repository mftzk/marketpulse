# MarketPulse environment.
# Copy to .env:  cp .env.example .env
# Every value below is a safe local/demo default. Nothing here is a secret.

# --- Database (PostgreSQL) -------------------------------------------------
# When running via docker-compose the app reaches the bundled `db` service.
# On the Nrapken platform, attaching a Postgres DBaaS injects DATABASE_URL for you.
DATABASE_URL=postgres://marketpulse:marketpulse@localhost:5432/marketpulse

# --- Cache (Redis; OPTIONAL) ----------------------------------------------
# Leave empty to use the in-process memory cache. The cache is never a source
# of truth: every read re-reads Postgres on a miss.
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# --- LLM (classification) --------------------------------------------------
# Optional. Without a key the pipeline falls back to the rules classifier.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Providers -------------------------------------------------------------
# Mock feeds are deterministic/simulated and surfaced as DEMO. Vendor feeds
# with missing credentials are UNAVAILABLE; they never silently use mock data.
# NEWS_PROVIDER=benzinga requires BENZINGA_API_KEY.
NEWS_PROVIDER=mock
# backfill = deterministic demo history; live = simulated demo stream only.
NEWS_MODE=live
# Lookback window (minutes) for the fetch_news step. Vendor feeds return a
# single ascending page (pageSize=100); a window wider than one page only
# replays already-stored (oldest) articles and never sees fresh ones, logging
# `news_window_saturated`. Keep it narrow enough to fit in one page. Default 240.
NEWS_LOOKBACK_MINUTES=240
# MARKET_PROVIDER=massive requires MASSIVE_API_KEY.
MARKET_PROVIDER=mock
# FUNDAMENTAL_PROVIDER=fmp requires FMP_API_KEY.
# Free-tier FMP keys cannot use `analyst-estimates?period=quarter`, `limit > 5`,
# intraday charts, batch quotes, news endpoints, or some symbols (e.g. SMH). The
# adapter degrades per endpoint (quarterly estimates fall back to annual) and
# never lets a vendor error fail a pipeline tick. Quarterly `earnings` +
# `income-statement` remain the primary source on every plan.
FUNDAMENTAL_PROVIDER=mock
MASSIVE_API_KEY=
BENZINGA_API_KEY=
FMP_API_KEY=
# In-process FMP fundamentals cache TTL (ms). Fundamentals are quarterly data, so
# a long TTL keeps a 250-request/day plan comfortable. One refresh is at most
# 3 requests per supported universe ticker (earnings + income-statement +
# analyst-estimates); for the 7 supported symbols that is <= 21 calls per 12h
# window (<= 42/day, comfortably inside 250). A symbol the plan is not entitled
# to (e.g. AVGO returns HTTP 402 "not available under your current subscription")
# is recorded as unsupported and skipped after the first attempt; a symbol that
# fails transiently (timeout/5xx/network) is still retried on the next refresh.
# A degraded (vendor-down) result is cached for at most 5 minutes so it recovers
# without a quota spike.
FMP_CACHE_TTL_MS=43200000
# How long (ms) an unsupported symbol is skipped before it is retried. An
# entitlement is a plan property, not a transient outage, so the default is 24h.
FMP_UNSUPPORTED_COOLDOWN_MS=86400000

# --- Live feed origin ------------------------------------------------------
# 1 (default) = the dashboard event feed (`GET /api/events`, its totals and
# pagination) excludes demo-origin events: an event whose canonical article is
# missing or whose news_articles.data_status is not 'LIVE'. Demo rows stay in
# the database (and in `/replay`) and come back when this is 0.
FEED_LIVE_ONLY=1
# When FEED_LIVE_ONLY=1, allow at most this many of the newest demo-origin
# events back into the feed for visual richness. 0 = none.
FEED_DEMO_MAX_ITEMS=0

# --- Pipeline scheduler ----------------------------------------------------
# 1 = start the in-process scheduler; 0 = only POST /api/pipeline/run ticks.
PIPELINE_AUTORUN=0
PIPELINE_TICK_SECONDS=30
# Hard ceiling for a single tick (ms). If a tick exceeds it, the tick is marked
# failed, its advisory lock is released, and the scheduler moves on instead of
# wedging. A run still 'running' after max(3x this, 5 min) is treated as stale
# and recovered. Guards against slow/hung provider calls on small containers.
PIPELINE_TICK_DEADLINE_MS=90000
# Soft per-step budget (ms). Cooperative steps (notably fetch_market_data) stop
# between tickers once this budget is spent and resume on the next tick, so a
# slow step releases the tick lock instead of pinning the process.
PIPELINE_STEP_BUDGET_MS=20000
# Hard cap on LLM round-trips (batches of up to 10 articles) that classify_event
# may perform in a single tick. The remaining backlog is deferred to the next
# tick (logged as `deferred` / `skipped_no_budget`) so the step can never run
# unbounded on a small container.
PIPELINE_MAX_LLM_CALLS_PER_TICK=8
# Consecutive classify failures (timeout/network/invalid output) after which the
# LLM is skipped for the rest of the tick and the rules classifier takes over.
PIPELINE_LLM_FAILURE_STREAK_LIMIT=3
# Hard timeout applied to every LLM request (ms). Bounds a hung round-trip.
# Default 45000: real vendor articles are long, so the request needs headroom
# (still well under PIPELINE_TICK_DEADLINE_MS). Lower it only for tiny fixtures.
LLM_TIMEOUT_MS=45000
# Max characters of each article body sent to the classifier. Headlines are
# always sent in full; the body is truncated at a sentence/word boundary. Keeps
# a multi-thousand-character vendor article from blowing the request timeout.
LLM_MAX_ARTICLE_CHARS=1200
# Hard cap on market snapshot rows written per table (price/volume) per tick,
# summed across all tickers. Keeps one tick bounded on a small container; the
# remainder is written by subsequent ticks.
PIPELINE_MARKET_MAX_ROWS=2000
# Hard cap on minute bars persisted per ticker per tick. If a ticker's un-written
# delta exceeds it, the newest slice is written and the truncation is logged.
PIPELINE_MARKET_MAX_BARS_PER_TICKER=500
# Hard cap on events the incremental tail steps (market reaction, impact score,
# alerts) may (re)write per tick. They only touch events whose inputs changed,
# and defer the remainder to later ticks, so a backlog drains across ticks
# instead of overrunning the deadline. Larger = faster drain, longer ticks.
PIPELINE_MAX_EVENTS_PER_TICK=40

# --- Provider HTTP ---------------------------------------------------------
# Timeout for every vendor REST request (news/market/fundamental). An
# unreachable vendor aborts instead of hanging a pipeline tick.
PROVIDER_HTTP_TIMEOUT_MS=8000

# --- App -------------------------------------------------------------------
LOG_LEVEL=info
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Auth ------------------------------------------------------------------
# 1 = require a signed-in session for every page/API route. Public: /login,
# POST /api/auth/login and GET /api/health. Set AUTH_ENABLED=0 to disable the
# gate for local development.
AUTH_ENABLED=1
# HMAC key for the signed `mp_session` cookie. Required (>= 32 chars) when auth
# is enabled. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-session-secret-change-me-32chars

# --- Admin account (seeded) ------------------------------------------------
# The single account the seed creates and owns the default watchlist/alerts.
# ADMIN_PASSWORD is required to create the account — there is no default. Leave
# it empty to seed only the market dataset (local/CI). Rotate the password by
# changing ADMIN_PASSWORD and re-running the seed.
ADMIN_EMAIL=zakaria@nrapken.dev
ADMIN_DISPLAY_NAME=Zakaria
ADMIN_PASSWORD=

# --- Alert channels (all optional) -----------------------------------------
# `log` is always available. The rest report "not_configured" until set.
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_DISCORD_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
SMTP_URL=
